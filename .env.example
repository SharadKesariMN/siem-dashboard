# Database
POSTGRES_USER=siem_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=siem_dashboard
DATABASE_URL=postgresql://siem_admin:changeme@postgres:5432/siem_dashboard

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_PORT=8000
LOG_LEVEL=INFO

# AI Layer
ANTHROPIC_API_KEY=your_api_key_here

# Splunk HEC (optional forwarding)
